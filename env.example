# Discord
DISCORD_TOKEN=COLOQUE_O_TOKEN_DO_BOT
DISCORD_CLIENT_ID=COLOQUE_O_APPLICATION_ID
DISCORD_PUBLIC_KEY=COLOQUE_A_PUBLIC_KEY
# Opcional. Se preencher, os slash commands aparecem quase imediatamente nesse servidor.
DISCORD_GUILD_ID=

# Canais de logs
LOG_GENERAL_CHANNEL_ID=
LOG_ADMIN_CHANNEL_ID=
LOG_PUNISHMENTS_CHANNEL_ID=
LOG_ANTICHEAT_CHANNEL_ID=
LOG_RANKS_CHANNEL_ID=

# Segurança Roblox -> Backend
# Gere com: npm run secret
ROBLOX_SHARED_SECRET=TROQUE_POR_UM_SEGREDO_FORTE

# Backend
PORT=3000
DATA_DIR=./data
PUBLIC_BASE_URL=

# Ajustes
ROBLOX_AUTH_MAX_SKEW_SECONDS=120
ACTIVE_SERVER_TIMEOUT_SECONDS=75
LOG_RETENTION_DAYS=7
MAX_RECENT_LOGS_IN_MEMORY=5000
